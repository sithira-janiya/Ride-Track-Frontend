{
  "installCommand": "cd ../app && npm install",
  "buildCommand": "cd ../app && npm run build:web && rm -rf ../src/dist && mv dist ../src/dist",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/"
    }
  ]
}
