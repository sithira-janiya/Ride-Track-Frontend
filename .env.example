# Copy to .env.local
# On a physical phone, "localhost" is the phone itself: use your computer's LAN IP (e.g. http://192.168.1.20:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000
# false = talk to the RideTrack-API backend, true = use the built-in mock API (no backend needed)
EXPO_PUBLIC_USE_MOCK_API=false
# Regions the app shows, comma-separated: SRI_LANKA (default when empty) and/or DUBAI. With one region, the region
# pickers and labels are hidden. Example for both: SRI_LANKA,DUBAI
EXPO_PUBLIC_REGIONS=SRI_LANKA
# Google Cloud Translation API key (Cloud Console → APIs & Services → Credentials). Translates the UI into the
# language picked on the Profile screen. This ships inside the app, so restrict it to the Cloud Translation API
# and to your app's bundle IDs / web domain. Leave empty to keep the app in English.
EXPO_PUBLIC_GOOGLE_TRANSLATE_API_KEY=
# Google Maps API key for the live map on Android (Cloud Console → APIs & Services → Credentials). Enable
# "Maps SDK for Android" and restrict the key to it and to package com.ridetrack.app + your SHA-1 fingerprint.
# Read by app.config.ts at build time, not by the JS bundle. After changing it: npx expo prebuild -p android --clean
GOOGLE_MAPS_API_KEY=

# Test logins (for reference only, not read by the app). All use the password: Password1!
# Mock mode: defined in src/api/mock.ts. Real backend: passenger, staff and officer are created by `npm run seed` in RideTrack-API.
#   Passenger           passenger@ridetrack.test
#   Passenger (phone)   0771234567                 (mock mode only)
#   Staff (conductor)   staff@ridetrack.test
#   Staff (inspector)   inspector@ridetrack.test   (mock mode only)
#   Authority (officer) officer@ridetrack.test
