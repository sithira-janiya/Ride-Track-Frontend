# Copy to .env.local
# On a physical phone, "localhost" is the phone itself: use your computer's LAN IP (e.g. http://192.168.1.20:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000
# false = talk to the RideTrack-API backend, true = use the built-in mock API (no backend needed)
EXPO_PUBLIC_USE_MOCK_API=false
