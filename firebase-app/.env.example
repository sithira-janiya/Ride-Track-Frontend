# Copy this file to .env and fill in the values. Never commit .env.
# Get the Firebase values from the backend owner (Firebase console -> Project settings -> Your apps -> Web app).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Google Maps key for the installed APK (Expo Go does not need it). See docs/design/MAPS-SETUP.md.
EXPO_PUBLIC_MAPS_API_KEY=

# Optional: use the local Firebase emulators from the backend repo instead of the real project.
# Use your computer's Wi-Fi IP (for example 192.168.1.20) when testing on a phone.
# TEMPORARY until real login exists: password of the seeded test accounts (see docs/design/BACKEND.md).
# With this set, Continue as Passenger / Conductor / Authority signs in as the seeded test user.
EXPO_PUBLIC_DEV_TEST_PASSWORD=

EXPO_PUBLIC_USE_EMULATOR=false
EXPO_PUBLIC_EMULATOR_HOST=localhost
